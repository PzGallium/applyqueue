# Firebase Config (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 本地：若启动「完整」模拟器（含 Auth），Functions 会只认 Auth 模拟器里的用户。
# 设 true 并 connect 到 9099 后请重新登录；不设则请用「不启动 Auth 模拟器」的方式（见 README）。
# VITE_USE_AUTH_EMULATOR=true
# VITE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
