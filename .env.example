# ============================================
# ApplyQueue Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Firebase Config (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (for Cloud Functions — set via firebase functions:secrets:set)
# ENCRYPTION_MASTER_KEY=   ← DO NOT put here, use Firebase Secrets Manager

# Optional: Analytics
VITE_PLAUSIBLE_DOMAIN=applyqueue.com
