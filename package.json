{
  "name": "applyqueue",
  "version": "0.1.0",
  "private": true,
  "description": "Execution-first job application workflow tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/applyqueue/applyqueue"
  },
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy:hosting": "pnpm build && firebase deploy --only hosting",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "emulators": "firebase emulators:start --only functions,firestore,storage,hosting,ui",
    "emulators:all": "firebase emulators:start"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  }
}
